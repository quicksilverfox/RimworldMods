<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Letter/message fields are literal text (like vanilla), not translation keys: the game formats them
       directly and never runs them through Translate(). Translations belong in DefInjected. -->
  <MentalStateDef>
    <defName>AL_HuntingWildAnimal</defName>
    <label>hunting spree</label>
    <stateClass>AnimalsLogic.MentalBreaks.MentalState_HuntWildAnimal</stateClass>
    <workerClass>AnimalsLogic.MentalBreaks.MentalStateWorker_HuntWildAnimal</workerClass>
    <category>Aggro</category>
    <nameColor>(0.85, 0.55, 0.15)</nameColor>
    <blockNormalThoughts>false</blockNormalThoughts>
    <allowBeatfire>true</allowBeatfire>
    <recoveryMtbDays>0.5</recoveryMtbDays>
    <minTicksBeforeRecovery>5000</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>25000</maxTicksBeforeRecovery>
    <colonistsOnly>true</colonistsOnly>
    <prisonersCanDo>false</prisonersCanDo>
    <requiredCapacities>
      <li>Moving</li>
      <li>Manipulation</li>
    </requiredCapacities>
    <beginLetterLabel>hunting spree</beginLetterLabel>
    <beginLetter>{PAWN_nameDef} has snapped and is going on a hunting spree, seeking to kill wild animals.</beginLetter>
    <beginLetterDef>ThreatSmall</beginLetterDef>
    <recoveryMessage>{0} has recovered from the hunting spree.</recoveryMessage>
    <baseInspectLine>Mental state: Hunting spree</baseInspectLine>
    <moodRecoveryThought>Catharsis</moodRecoveryThought>
  </MentalStateDef>

</Defs>
